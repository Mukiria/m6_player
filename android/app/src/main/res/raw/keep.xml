<?xml version="1.0" encoding="utf-8"?>
<!-- Icons that are only named from Dart, so the release build's resource shrinker
     would otherwise delete them: our notification icon, and audio_service's
     play/pause/next/previous/stop button icons. Without the button icons
     audio_service can't build the playback notification at all (it throws
     "You must specify an icon resource id to build a CustomAction"). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_m6,@drawable/audio_service_*" />
